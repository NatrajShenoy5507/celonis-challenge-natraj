# Local mock target. Remote load is disabled unless explicitly authorized.
K6_TARGET_URL=http://127.0.0.1:3000
K6_ALLOW_REMOTE=false

# Fixed-iteration baseline.
K6_BASELINE_VUS=1
K6_BASELINE_ITERATIONS=30

# Gradual load profile: concurrency ramps up, holds, then ramps down.
K6_LOAD_START_VUS=1
K6_LOAD_TARGET_VUS=10
K6_RAMP_UP=20s
K6_HOLD=30s
K6_RAMP_DOWN=10s

# Optional short local-only stress and soak demonstrations.
K6_STRESS_TARGET_VUS=20
K6_STRESS_RAMP_UP=20s
K6_STRESS_HOLD=20s
K6_STRESS_RAMP_DOWN=10s
K6_SOAK_VUS=5
K6_SOAK_DURATION=2m

# Illustrative thresholds only; these are not Celonis SLAs/SLOs.
K6_ACCEPT_P95_MS=500
K6_ACCEPT_ERROR_RATE=0.01

# Optional sampled completion observation. Polling time is not exact processing lag.
K6_COMPLETION_SAMPLE_RATE=0
K6_COMPLETION_POLL_INTERVAL_MS=50
K6_COMPLETION_MAX_POLLS=4

# Local mock behavior and safety cap.
MOCK_PORT=3000
MOCK_PROCESSING_DELAY_MS=100
MOCK_MAX_ORDERS=10000

# Optional bearer token for a future authorized target; never logged or summarized.
K6_API_TOKEN=

# Optional safe build label recorded in summaries.
APP_BUILD_ID=
